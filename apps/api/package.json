    "ali-oss": "^6.23.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "nodemon": "^3.0.3",
    "typescript": "~5.9.3"
  }

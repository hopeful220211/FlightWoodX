MONGODB_URI=mongodb://localhost:27017/flightwoodx
PORT=3000
JWT_SECRET=your-secret-here
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# 管理后台访问密钥（临时方案，Q3 2026 接入 RBAC 后移除）
ADMIN_ACCESS_KEY=your-admin-access-key-here

# 对象存储（S3 兼容协议：阿里云 OSS / 腾讯云 COS / AWS S3）— RFC-012 A6/A8
# STORAGE_DRIVER=disk 用本地磁盘（开发）；=s3 用下面的 S3 兼容配置（生产）
STORAGE_DRIVER=disk
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 上传文件经 CDN 访问的域名前缀（如 https://cdn.flightwoodx.com）
CDN_DOMAIN=

# ============================================================================
# FlightWoodX 部署环境变量（RFC-024 §4.8）—— 复制为 deploy/.env 后填真实值。
# ⚠️ deploy/.env 已被 .gitignore 忽略，绝不入库。绝不把任何真实 AK/SK/连接串写进仓库。
# ============================================================================

# ---- 后端应用 ----
# 库连接：docker-compose 已在 api 服务里覆盖为内网 mongo，此处仅供本地非 docker 运行参考。
MONGODB_URI=mongodb://mongo:27017/flightwoodx
# JWT 签名密钥（务必换成足够长的随机串）
JWT_SECRET=
# 允许的前端来源（逗号分隔，含 .com 与未来 .cn）
CORS_ORIGIN=https://flightwoodx.com,https://www.flightwoodx.com
# 管理后台临时访问口令（Q3 换 RBAC）
ADMIN_ACCESS_KEY=
# 上传文件对外基址（disk 模式用；生产走 OSS/CDN，见下）
PUBLIC_BASE_URL=https://flightwoodx.com

# ---- 对象存储（阿里云 OSS）----
# disk=本地磁盘(开发) / s3=S3兼容 / oss=阿里云OSS(国内生产)
STORAGE_DRIVER=oss
OSS_REGION=oss-cn-chengdu
OSS_ASSETS_BUCKET=fwx-assets        # 公共读：GLB/贴图/缩略图/封面
OSS_PRIVATE_BUCKET=fwx-private      # 私有：数据库备份等
OSS_ACCESS_KEY_ID=
OSS_SECRET=
# CDN/自定义域名（可选，配了则资产 URL 用它）
CDN_DOMAIN=

# ---- OSS 直传 STS（浏览器直传，文件不经 ECS）----
OSS_STS_ROLE_ARN=                   # 形如 acs:ram::<uid>:role/fwx-upload
# STS 建议用最小权限子账号；不单独配则复用上面的 OSS 主 AK
OSS_STS_ACCESS_KEY_ID=
OSS_STS_SECRET=

# ---- 前端构建（Vite）----
# 资产 base：生产指向 OSS 公共读桶或 CDN；留空则用本地相对路径
VITE_ASSET_BASE=https://fwx-assets.oss-cn-chengdu.aliyuncs.com
# 前端请求的 API 基址
VITE_API_URL=https://flightwoodx.com/api

# ---- nginx / HTTPS ----
FWX_SERVER_NAME="flightwoodx.com www.flightwoodx.com"
FWX_SSL_CERT=/etc/letsencrypt/live/flightwoodx.com/fullchain.pem
FWX_SSL_CERT_KEY=/etc/letsencrypt/live/flightwoodx.com/privkey.pem
# 前端构建产物目录（nginx 托管）与 certbot 目录（一般用默认）
WEB_DIST_DIR=../apps/web/dist
CERTBOT_DIR=/etc/letsencrypt

# ---- 装机 / 运维 ----
# 阿里云容器镜像加速器地址（控制台「容器镜像服务」获取，形如 https://xxxx.mirror.aliyuncs.com）
REGISTRY_MIRROR=
# 数据迁移：源 Atlas 连接串（仅 migrate-from-atlas.sh 用）
SRC_MONGODB_URI=
# 目标库名
DEST_DB=flightwoodx
# 源库名（旧连接串无库名时 Mongoose 默认落进 test 库；迁移时改名成 DEST_DB）
SRC_DB=test
